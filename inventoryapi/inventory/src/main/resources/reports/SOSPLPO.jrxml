    <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
</parameter>
	
	<queryString>
    <![CDATA[SELECT pht.po_ref_no AS PO_REF_NO, pht.po_no AS PO_NO, smt.supplier_name AS SUPPLIER_NAME, smt.address AS SUPPLIER_ADDRESS, DATE_FORMAT(pht.po_date, '%d-%m-%Y') AS PO_DATE, pht.po_payment_terms AS PO_PAYMENT_TERMS, pht.po_remarks AS PO_REMARKS, pht.po_delivery_terms AS PO_DELIVERY_TERMS, DATE_FORMAT(pht.po_delivery_schedule, '%d-%m-%Y') AS PO_DELIVERY_SCHEDULE, pht.po_kind_attention AS PO_KIND_ATTENTION, pht.po_reference AS PO_REFERENCE FROM sos_po_header_t pht LEFT JOIN sos_supplier_master_t smt ON pht.supplier_id = smt.supplier_id WHERE pht.po_no = $P{PO_NO}]]>
</queryString>
