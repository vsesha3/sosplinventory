		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
		<parameter name="PO_NO" class="java.lang.String" evaluationTime="Late"/>
	<queryString>
    <![CDATA[SELECT SUM(pdt.po_qty) AS RM_QTY_1, SUM(pdt.po_rate * pdt.po_qty) AS NET_RATE_1, SUM(pdt.sgst_value) AS SGST_VALUE_1, SUM(pdt.cgst_value) AS CGST_VALUE_1, SUM(pdt.igst_value) AS IGST_VALUE_1 FROM sos_po_details_t pdt LEFT JOIN sos_po_header_t pht ON pdt.po_ref_no = pht.po_ref_no WHERE pht.po_no = $P{PO_NO} GROUP BY pdt.po_ref_no]]>
</queryString>
		<field name="RM_QTY_1" class="java.lang.Float"/>
		<field name="NET_RATE_1" class="java.lang.Float"/>
		<field name="SGST_RATE_Q" class="java.lang.Float"/>
		<field name="CGST_RATE_1" class="java.lang.Float"/>
		<field name="IGST_RATE_1" class="java.lang.Float"/>
