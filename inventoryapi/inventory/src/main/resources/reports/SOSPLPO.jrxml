	<subDataset name="Dataset1" uuid="fe84e4a9-ff50-44dd-bdec-b4617434d632">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="NO_DATA_ADAPTER"/>
		<parameter name="PO_NO" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		
		<queryString>
			<![CDATA[SELECT pdt.po_rm_code AS RM_CODE, pdt.po_rm_name AS RM_NAME, pdt.po_qty AS RM_QTY, pdt.po_no_of_packs AS NO_OF_PACKS, pdt.po_qty AS ORDER_QTY, pdt.po_rate AS BASIC_PRICE, pdt.sgst AS SGST, pdt.sgst_value AS SGST_VALUE, pdt.cgst AS CGST, pdt.cgst_value AS CGST_VALUE, pdt.igst AS IGST, pdt.igst_value AS IGST_VALUE, (pdt.po_qty * pdt.po_rate) AS NET_RATE, pdt.po_uom AS UOM FROM sos_po_details_t pdt LEFT JOIN sos_po_header_t pht ON pdt.po_ref_no = pht.po_ref_no WHERE pht.po_no = $P{PO_NO}]]>
		</queryString>
		<field name="RM_NAME" class="java.lang.String"/>
		<field name="RM_QTY" class="java.lang.Float"/>
		<field name="RM_CODE" class="java.lang.String"/>
		<field name="NO_OF_PACKS" class="java.lang.Integer"/>
		<field name="ORDER_QTY" class="java.math.BigDecimal"/>
		<field name="BASIC_PRICE" class="java.math.BigDecimal"/>
		<field name="SGST" class="java.lang.Float"/>
		<field name="SGST_VALUE" class="java.lang.Float"/>
		<field name="CGST" class="java.lang.Float"/>
		<field name="CGST_VALUE" class="java.lang.Float"/>
		<field name="IGST" class="java.lang.Float"/>
		<field name="IGST_VALUE" class="java.lang.Float"/>
		<field name="NET_RATE" class="java.lang.Float"/>
		<field name="UOM" class="java.lang.String"/>
		<variable name="QUANTITY_1" class="java.math.BigDecimal" resetType="Column" calculation="Sum">
			<variableExpression><![CDATA[$F{RM_QTY}]]></variableExpression>
		</variable>
		<variable name="SGST_VALUE_1" class="java.lang.Float" calculation="Sum">
			<variableExpression><![CDATA[$F{SGST_VALUE}]]></variableExpression>
		</variable>
		<variable name="BASIC_PRICE_1" class="java.lang.Float" calculation="Sum">
			<variableExpression><![CDATA[$F{NET_RATE}]]></variableExpression>
		</variable>
		<variable name="CGST_VALUE_1" class="java.lang.Float" calculation="Sum">
			<variableExpression><![CDATA[$F{CGST_VALUE}]]></variableExpression>
		</variable>
		<variable name="IGST_VALUE_1" class="java.lang.Float" calculation="Sum">
			<variableExpression><![CDATA[$F{IGST_VALUE}]]></variableExpression>
			<initialValueExpression><![CDATA[0]]></initialValueExpression>
		</variable>
	</subDataset>
	<subDataset name="rateDataTable" uuid="010fec7d-bba7-46c3-b174-4b9b5046b62c">
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
    <parameter name="PO_NO" class="java.lang.String" evaluationTime="Late">
        <defaultValueExpression><![CDATA[$P{PO_NO}]]></defaultValueExpression>
    </parameter>
       
    <queryString>
        <![CDATA[SELECT NET_RATE_1, SGST_VALUE_1, CGST_VALUE_1, IGST_VALUE_1, NET_TOTAL, OTHERS FROM (SELECT mht.RM_QTY_1 AS RM_QTY_1, mht.NET_RATE_1 AS NET_RATE_1, mht.SGST_VALUE_1 AS SGST_VALUE_1, mht.CGST_VALUE_1 AS CGST_VALUE_1, mht.IGST_VALUE_1 AS IGST_VALUE_1, (mht.NET_RATE_1 + mht.SGST_VALUE_1 + mht.CGST_VALUE_1 + mht.IGST_VALUE_1) AS NET_TOTAL, COALESCE(pht.add_charges, 0.00) AS OTHERS FROM (SELECT SUM(pdt.po_qty) AS RM_QTY_1, SUM(pdt.po_rate * pdt.po_qty) AS NET_RATE_1, SUM(pdt.sgst_value) AS SGST_VALUE_1, SUM(pdt.cgst_value) AS CGST_VALUE_1, COALESCE(SUM(pdt.igst_value), 0) AS IGST_VALUE_1 FROM sos_po_details_t pdt LEFT JOIN sos_po_header_t pht ON pdt.po_ref_no = pht.po_ref_no WHERE pht.po_no = $P{PO_NO}) mht LEFT JOIN sos_po_header_t pht ON pht.po_no = $P{PO_NO}) final_result]]>
    </queryString>
    <field name="NET_RATE_1" class="java.lang.Float"/>
    <field name="SGST_VALUE_1" class="java.lang.Float"/>
    <field name="CGST_VALUE_1" class="java.lang.Float"/>
    <field name="IGST_VALUE_1" class="java.lang.Float"/>
    <field name="OTHERS" class="java.lang.Float"/>
    <field name="NET_TOTAL" class="java.lang.Float"/>
</subDataset>
